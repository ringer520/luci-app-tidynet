#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
. /usr/lib/tidynet/core.sh
case "$1" in
 list)
  printf '%s\n' '{"status":{},"settings":{},"stats":{},"configure":{"payload":"String"},"action":{"operation":"String","section":"String"},"resolve":{"domain":"String"}}';;
 call)
  input=$(head -c 24577)
  [ "${#input}" -le 24576 ] || { error '请求过大。'; exit 0; }
  case "$2" in
   status) status;;
   settings) settings;;
   stats) stats;;
   resolve) resolve "$(jget "$input" '@.domain')";;
   configure|action)
    lock || { error '另一个任务正在进行，请稍后重试。'; exit 0; }
    TN_DETACHED=0
    trap '[ "$TN_DETACHED" = 1 ] || unlock' EXIT
    if [ "$2" = configure ]; then configure_locked "$(jget "$input" '@.payload')"
    else action_locked "$(jget "$input" '@.operation')" "$(jget "$input" '@.section')"; fi;;
   *) error '未知接口。';;
  esac;;
esac

